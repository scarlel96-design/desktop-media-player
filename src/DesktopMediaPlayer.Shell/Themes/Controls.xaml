<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Lumen F-3: styles moved from MainWindow.Resources; colors via Legacy tokens (values unchanged). -->
  <Style x:Key="TransportButton" TargetType="Button">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource Lumen.Legacy.ButtonFaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Legacy.TextOnDarkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Legacy.ButtonBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style x:Key="ChromeCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Lumen.Type.Caption}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Lumen.Font.Mono}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Text.SecondaryBrush}"/>
  </Style>
  <Style x:Key="SidePanel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Lumen.Legacy.FlyoutBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Legacy.ButtonBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,0,0"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style x:Key="ChromeDivider" TargetType="Border">
    <Setter Property="Width" Value="{DynamicResource Lumen.Size.Divider}"/>
    <Setter Property="Height" Value="{DynamicResource Lumen.Size.DividerHeight}"/>
    <Setter Property="Background" Value="{DynamicResource Lumen.Border.SubtleBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <!-- Lumen T3-2: SeekSlider template. Standard Track/Thumb/RepeatButtons (PART_Track, Track.Thumb kept); rail and buffer are drawn by BufferBar. -->
  <Style x:Key="LumenSeekSlider" TargetType="Slider">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <ControlTemplate.Resources>
            <Style x:Key="SeekHitButton" TargetType="RepeatButton">
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="IsTabStop" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="SeekFillButton" TargetType="RepeatButton" BasedOn="{StaticResource SeekHitButton}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                      <Border Height="{DynamicResource Lumen.Size.TrackRest}" Margin="0,0,-7,0" VerticalAlignment="Center" Background="{DynamicResource Lumen.AccentBrush}"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="SeekThumbStyle" TargetType="Thumb">
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Width" Value="14"/>
              <Setter Property="Height" Value="14"/>
              <Setter Property="Opacity" Value="0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                      <Ellipse Width="14" Height="14" Fill="{DynamicResource Lumen.Text.PrimaryBrush}"
                               Stroke="{DynamicResource Lumen.Surface.ChromeBrush}" StrokeThickness="1"/>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ControlTemplate.Resources>
          <Grid Background="Transparent">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SeekFillButton}" Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SeekHitButton}" Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="SeekThumb" Style="{StaticResource SeekThumbStyle}"/>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
