<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Lumen F-3: styles moved from MainWindow.Resources; colors via Legacy tokens (values unchanged). -->
  <Style x:Key="TransportButton" TargetType="Button">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource Lumen.Legacy.ButtonFaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Legacy.TextOnDarkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Legacy.ButtonBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style x:Key="ChromeCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Lumen.Type.Caption}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Lumen.Font.Mono}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Text.SecondaryBrush}"/>
  </Style>
  <Style x:Key="ChromeTimeLabel" TargetType="TextBlock" BasedOn="{StaticResource ChromeCaption}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="--:--">
        <Setter Property="Foreground" Value="{DynamicResource Lumen.Text.TertiaryBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ChromeTimeCurrent" TargetType="TextBlock" BasedOn="{StaticResource ChromeTimeLabel}">
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
  </Style>
  <Style x:Key="SidePanel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Lumen.Legacy.FlyoutBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Lumen.Legacy.ButtonBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,0,0"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style x:Key="ChromeDivider" TargetType="Border">
    <Setter Property="Width" Value="{DynamicResource Lumen.Size.Divider}"/>
    <Setter Property="Height" Value="{DynamicResource Lumen.Size.DividerHeight}"/>
    <Setter Property="Background" Value="{DynamicResource Lumen.Border.SubtleBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <!-- Lumen T3-2: SeekSlider template. Standard Track/Thumb/RepeatButtons (PART_Track, Track.Thumb kept); rail and buffer are drawn by BufferBar. -->
  <Style x:Key="LumenSeekSlider" TargetType="Slider">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <ControlTemplate.Resources>
            <Style x:Key="SeekHitButton" TargetType="RepeatButton">
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="IsTabStop" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="SeekFillButton" TargetType="RepeatButton" BasedOn="{StaticResource SeekHitButton}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                      <Border Height="{DynamicResource Lumen.Size.TrackRest}" Margin="0,0,-7,0" VerticalAlignment="Center" Background="{DynamicResource Lumen.AccentBrush}"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="SeekThumbStyle" TargetType="Thumb">
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Width" Value="14"/>
              <Setter Property="Height" Value="14"/>
              <Setter Property="Opacity" Value="0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                      <Ellipse Width="14" Height="14" Fill="{DynamicResource Lumen.Text.PrimaryBrush}"
                               Stroke="{DynamicResource Lumen.Surface.ChromeBrush}" StrokeThickness="1"/>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ControlTemplate.Resources>
          <Grid Background="Transparent">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SeekFillButton}" Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SeekHitButton}" Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="SeekThumb" Style="{StaticResource SeekThumbStyle}"/>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Lumen V5-1: VolumeSlider template. Same structure as LumenSeekSlider; no BufferBar here so the template draws the rail. -->
  <Style x:Key="LumenVolumeSlider" TargetType="Slider">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <ControlTemplate.Resources>
            <Style x:Key="VolHitButton" TargetType="RepeatButton">
              <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                      <Border Height="{DynamicResource Lumen.Size.TrackRest}" Margin="-7,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Lumen.Track.RailBrush}"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="VolFillButton" TargetType="RepeatButton" BasedOn="{StaticResource VolHitButton}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                      <Border Height="{DynamicResource Lumen.Size.TrackRest}" Margin="0,0,-7,0" VerticalAlignment="Center" Background="{DynamicResource Lumen.AccentBrush}"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="VolThumbStyle" TargetType="Thumb">
              <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Focusable" Value="False"/>
              <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Opacity" Value="0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent"><Ellipse Width="14" Height="14" Fill="{DynamicResource Lumen.Text.PrimaryBrush}" Stroke="{DynamicResource Lumen.Surface.ChromeBrush}" StrokeThickness="1"/></Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ControlTemplate.Resources>
          <Grid Background="Transparent">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource VolFillButton}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource VolHitButton}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="VolThumb" Style="{StaticResource VolThumbStyle}"/>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="VolThumb" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="VolThumb" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="VolThumb" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Lumen P4-3: icon button templates (unapplied; consumers added in a later Atomic). -->
  <Style x:Key="LumenIconButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Width" Value="{DynamicResource Lumen.Size.Hit}"/>
    <Setter Property="Height" Value="{DynamicResource Lumen.Size.Hit}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Text.SecondaryBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="Transparent" CornerRadius="{DynamicResource Lumen.Radius.Control}">
            <Path x:Name="Icon" Data="{TemplateBinding Content}"
                  Fill="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="None"
                  Width="{DynamicResource Lumen.Size.Icon}" Height="{DynamicResource Lumen.Size.Icon}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lumen.State.HoverOverlayBrush}"/>
              <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
              <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lumen.State.PressedOverlayBrush}"/>
              <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
              <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="Transparent"/>
              <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Lumen.Icon.DisabledBrush}"/>
              <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Lumen.Icon.DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LumenPrimaryIconButton" TargetType="Button" BasedOn="{StaticResource LumenIconButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="{DynamicResource Lumen.State.HoverOverlayBrush}" CornerRadius="20">
            <Path x:Name="Icon" Data="{TemplateBinding Content}"
                  Fill="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="None"
                  Width="{DynamicResource Lumen.Size.Icon}" Height="{DynamicResource Lumen.Size.Icon}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lumen.State.PressedOverlayBrush}"/>
              <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
              <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lumen.State.PressedOverlayBrush}"/>
              <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
              <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Lumen.Text.PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="Transparent"/>
              <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Lumen.Icon.DisabledBrush}"/>
              <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Lumen.Icon.DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
