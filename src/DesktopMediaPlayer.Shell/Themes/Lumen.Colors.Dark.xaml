<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Lumen.Surface.WindowColor">#121212</Color>
  <SolidColorBrush x:Key="Lumen.Surface.WindowBrush" Color="{StaticResource Lumen.Surface.WindowColor}" />
