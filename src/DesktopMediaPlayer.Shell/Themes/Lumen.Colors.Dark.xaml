  <SolidColorBrush x:Key="Lumen.Track.BufferBrush" Color="{StaticResource Lumen.Track.BufferColor}" />
  <Color x:Key="Lumen.DangerColor">#FF6B6B</Color>
  <SolidColorBrush x:Key="Lumen.DangerBrush" Color="{StaticResource Lumen.DangerColor}" />
  <SolidColorBrush x:Key="Lumen.Legacy.WindowBrush" Color="#121212" />
  <SolidColorBrush x:Key="Lumen.Legacy.ForegroundBrush" Color="#F0F0F0" />
  <SolidColorBrush x:Key="Lumen.Legacy.ChromeBrush" Color="#E6121212" />
  <SolidColorBrush x:Key="Lumen.Legacy.StatusBrush" Color="#A0FFFFFF" />
