<Window x:Class="DesktopMediaPlayer.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopMediaPlayer.Shell"
        Title="Desktop Media Player"
        Width="960" Height="640"
        MinWidth="640" MinHeight="400"
        Background="#121212"
        Foreground="#F0F0F0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <!-- S1: UX-001 Control Bar skeleton. Blur OFF. L1≤2. Facade-only wiring. -->
  <Window.Resources>
    <Style x:Key="TransportButton" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="BorderBrush" Value="#3A3A3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style x:Key="ChromeCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#C8C8C8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- L0 video -->
    <Border Background="#000000">
      <local:VideoHwndHost x:Name="VideoHost"/>
    </Border>

    <!-- L1 bottom chrome ≈92px (8 pad + 28 timeline + 8 gap + 48 controls) -->
    <Border x:Name="BottomChrome"
            VerticalAlignment="Bottom"
            Background="#E6121212"
            Padding="16,8,16,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="28"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- Timeline row (S2 wires Seek + buffer/hover). Hit ≥24 via MinHeight. -->
        <Grid Grid.Row="0" MinHeight="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                     Style="{StaticResource ChromeCaption}"
                     Text="--:--" Margin="0,0,12,0"/>
          <Slider x:Name="SeekSlider" Grid.Column="1"
                  Minimum="0" Maximum="3600" Value="0"
                  VerticalAlignment="Center"
                  Height="24"
                  IsMoveToPointEnabled="True"
                  PreviewMouseLeftButtonUp="SeekSlider_Committed"
                  LostMouseCapture="SeekSlider_LostCapture"/>
          <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                     Style="{StaticResource ChromeCaption}"
                     Text="--:--" Margin="12,0,0,0"/>
        </Grid>

        <!-- Transport / volume / utility row -->
        <DockPanel Grid.Row="2" LastChildFill="False">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
            <Button x:Name="OpenButton" Style="{StaticResource TransportButton}"
                    Content="⏏" ToolTip="Open" Click="Open_Click" FontSize="16"/>
            <Button x:Name="PrevButton" Style="{StaticResource TransportButton}"
                    Content="⏮" ToolTip="Previous (stop at ends)"
                    Click="Prev_Click" IsEnabled="False"/>
            <Button x:Name="PlayButton" Style="{StaticResource TransportButton}"
                    Content="▶" ToolTip="Play" Click="Play_Click"/>
            <Button x:Name="PauseButton" Style="{StaticResource TransportButton}"
                    Content="⏸" ToolTip="Pause" Click="Pause_Click"/>
            <Button x:Name="StopButton" Style="{StaticResource TransportButton}"
                    Content="⏹" ToolTip="Stop" Click="Stop_Click"/>
            <Button x:Name="NextButton" Style="{StaticResource TransportButton}"
                    Content="⏭" ToolTip="Next (stop at ends)"
                    Click="Next_Click" IsEnabled="False" Margin="0,0,16,0"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
            <Button x:Name="MuteButton" Style="{StaticResource TransportButton}"
                    Content="🔊" ToolTip="Mute (S4)" IsEnabled="False"/>
            <Slider x:Name="VolumeSlider"
                    Width="96"
                    Minimum="0" Maximum="100" Value="80"
                    VerticalAlignment="Center"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="VolumeSlider_ValueChanged"
                    ToolTip="Volume"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
            <Button Style="{StaticResource TransportButton}" Content="CC" ToolTip="Subtitles (S5)" IsEnabled="False"/>
            <Button Style="{StaticResource TransportButton}" Content="♪" ToolTip="Audio (S5)" IsEnabled="False"/>
            <Button Style="{StaticResource TransportButton}" Content="≡" ToolTip="Playlist (S5)" IsEnabled="False"/>
            <Button Style="{StaticResource TransportButton}" Content="⛶" ToolTip="Fullscreen (S5)"
                    Margin="0" IsEnabled="False"/>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Status / error overlay (top), not a second chrome L1 for video -->
    <StackPanel VerticalAlignment="Top" Margin="16" IsHitTestVisible="False">
      <TextBlock x:Name="StatusText" Text="Ready" Foreground="#A0FFFFFF" TextWrapping="Wrap"/>
      <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" Margin="0,6,0,0"
                 TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
  </Grid>
</Window>
