<Window x:Class="DesktopMediaPlayer.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopMediaPlayer.Shell"
        Title="Desktop Media Player (Step 0 Spike)"
        Width="960" Height="640"
        MinWidth="640" MinHeight="400"
        Background="#1E1E1E"
        Foreground="#F0F0F0">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" Text="Ready" Margin="0,0,0,6" TextWrapping="Wrap"/>
      <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"/>
      <DockPanel Margin="0,0,0,6">
        <TextBlock Text="Seek" Width="48" VerticalAlignment="Center"/>
        <Slider x:Name="SeekSlider" Minimum="0" Maximum="3600" Value="0"
                PreviewMouseLeftButtonUp="SeekSlider_Committed"
                LostMouseCapture="SeekSlider_LostCapture"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,6">
        <TextBlock Text="Volume" Width="48" VerticalAlignment="Center"/>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80"
                TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="VolumeSlider_ValueChanged"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="Open…" Width="80" Margin="0,0,8,0" Click="Open_Click"/>
        <Button Content="Play" Width="72" Margin="0,0,8,0" Click="Play_Click"/>
        <Button Content="Pause" Width="72" Margin="0,0,8,0" Click="Pause_Click"/>
        <Button Content="Stop" Width="72" Click="Stop_Click"/>
      </StackPanel>
    </StackPanel>
    <Border BorderBrush="#444" BorderThickness="1" Background="Black">
      <local:VideoHwndHost x:Name="VideoHost"/>
    </Border>
  </DockPanel>
</Window>
